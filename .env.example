# Copy to .env. Part 1 does not need a model or API key.
OPENAI_API_KEY=
MODEL_NAME=gpt-5.6-luna
OPENAI_BASE_URL=
# Reasoning models (gpt-5.x) need REASONING_EFFORT=none to use tools in Chat Completions.
# For gpt-4o-mini leave it empty.
REASONING_EFFORT=none
OPENAI_USE_RESPONSES_API=false
# Loop limit: maximum tool rounds per user message.
MAX_TOOL_ROUNDS=5
# Keep persistent data out of git.
HELPDESK_STORAGE_DIR=local-storage
LANGSMITH_TRACING=false
